# Caddy obtains and renews the TLS certificate for {$DOMAIN} automatically.
# It replaces any client-supplied X-Forwarded-For with the real client IP, which Nginx then
# trusts (private network) for per-IP rate limiting. Event streams are flushed immediately.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
