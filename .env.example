# Copy to .env for production-style runs. Never commit real values.
EXAMGRID_DB_URL=jdbc:postgresql://postgres:5432/examgrid
EXAMGRID_DB_USERNAME=examgrid
EXAMGRID_DB_PASSWORD=change-me
# At least 32 characters, e.g. `openssl rand -base64 48`
EXAMGRID_JWT_SECRET=
EXAMGRID_TOKEN_TTL=8h
EXAMGRID_CORS_ORIGINS=http://localhost:5173
# Creates the first exam cell account on an empty database only.
EXAMGRID_BOOTSTRAP_ADMIN_USERNAME=admin
EXAMGRID_BOOTSTRAP_ADMIN_PASSWORD=
